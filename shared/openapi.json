{
  "openapi": "3.1.0",
  "info": {
    "title": "agent-workflows console API",
    "description": "操作台后端 API：提供工作流运行列表、启动、详情查询与人工审批（interrupt/resume）接口。前后端唯一契约文件位于 shared/openapi.json。",
    "version": "0.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs": {
      "get": {
        "summary": "List Runs",
        "operationId": "list_runs_api_runs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunListOut"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Start Run",
        "operationId": "start_run_api_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartRunOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (e.g., empty task or invalid repo path)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{tid}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run_api_runs__tid__get",
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStateOut"
                }
              }
            }
          },
          "404": {
            "description": "Run Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{tid}/resume": {
      "post": {
        "summary": "Resume Run",
        "operationId": "resume_run_api_runs__tid__resume_post",
        "parameters": [
          {
            "name": "tid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Tid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeOut"
                }
              }
            }
          },
          "409": {
            "description": "Run is not in waiting state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/debug/threads": {
      "get": {
        "summary": "Debug Threads",
        "description": "排查用：直接看 checkpoint 里有哪些 thread。",
        "operationId": "debug_threads_api_debug_threads_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DebugThreadsOut"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DebugThreadsOut": {
        "properties": {
          "threads": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Threads"
          }
        },
        "type": "object",
        "required": [
          "threads"
        ],
        "title": "DebugThreadsOut"
      },
      "ErrorOut": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorOut"
      },
      "HealthOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "agent": {
            "type": "string",
            "title": "Agent"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "agent"
        ],
        "title": "HealthOut"
      },
      "InterruptPayload": {
        "properties": {
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage",
            "description": "审批阶段：plan_approval | final_approval"
          },
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          },
          "patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patch"
          },
          "test_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Output"
          },
          "review": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Options",
            "default": [
              "approve",
              "revise",
              "abort"
            ]
          }
        },
        "type": "object",
        "title": "InterruptPayload"
      },
      "ResumeIn": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "revise",
              "abort"
            ],
            "title": "Action",
            "description": "审批动作：approve(通过) | revise(打回重改) | abort(中止)",
            "default": "approve"
          },
          "feedback": {
            "type": "string",
            "title": "Feedback",
            "description": "revise 时的修改意见（approve/abort 可留空）",
            "default": ""
          }
        },
        "type": "object",
        "title": "ResumeIn"
      },
      "ResumeOut": {
        "properties": {
          "ok": {
            "type": "boolean",
            "title": "Ok"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          }
        },
        "type": "object",
        "required": [
          "ok",
          "thread_id"
        ],
        "title": "ResumeOut"
      },
      "RunIn": {
        "properties": {
          "task": {
            "type": "string",
            "title": "Task",
            "description": "任务描述，例如：给 verify_graph.py 加 --verbose 参数"
          },
          "repo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo",
            "description": "目标 git 仓库路径（服务器本地路径）"
          },
          "max_attempts": {
            "type": "integer",
            "maximum": 10,
            "minimum": 1,
            "title": "Max Attempts",
            "description": "测试-修复循环最大尝试次数",
            "default": 2
          },
          "test_cmd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Cmd",
            "description": "测试命令（在 repo 下执行，退出码 0 视为通过）"
          }
        },
        "type": "object",
        "required": [
          "task"
        ],
        "title": "RunIn"
      },
      "RunListOut": {
        "properties": {
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunStateOut"
            },
            "type": "array",
            "title": "Runs"
          }
        },
        "type": "object",
        "required": [
          "runs"
        ],
        "title": "RunListOut"
      },
      "RunStateOut": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "waiting",
              "running",
              "done",
              "error",
              "interrupted",
              "unknown"
            ],
            "title": "Status"
          },
          "next": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next",
            "default": []
          },
          "values": {
            "$ref": "#/components/schemas/RunValues"
          },
          "interrupts": {
            "items": {
              "$ref": "#/components/schemas/InterruptPayload"
            },
            "type": "array",
            "title": "Interrupts",
            "default": []
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "status"
        ],
        "title": "RunStateOut"
      },
      "RunValues": {
        "properties": {
          "task": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task"
          },
          "repo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repo"
          },
          "test_cmd": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Cmd"
          },
          "max_attempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Attempts"
          },
          "plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan"
          },
          "feedback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feedback"
          },
          "action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action"
          },
          "approved": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved"
          },
          "attempt": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attempt"
          },
          "patch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patch"
          },
          "test_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Output"
          },
          "passed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Passed"
          },
          "review": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Review"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "events": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Events",
            "default": []
          }
        },
        "type": "object",
        "title": "RunValues"
      },
      "StartRunOut": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "thread_id"
        ],
        "title": "StartRunOut"
      }
    }
  }
}
